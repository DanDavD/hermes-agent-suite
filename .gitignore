frontend/.next/
out/
frontend/out/
next-env.d.ts
*.tsbuildinfo
.vercel

# macOS native build artifacts
macos/build/
*.app/

# Local databases & SQLite persistence
*.db
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal

# OS-specific metadata
.DS_Store
Thumbs.db
*.log

